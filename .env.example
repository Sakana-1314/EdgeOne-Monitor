# =============================================================
# EdgeOne 监控大屏 - 环境变量示例
# 复制为 .env 后按需修改：  cp .env.example .env
# =============================================================

# ---- 鉴权（必须）----
# 登录账号固定为 admin，此处配置密码（本地开发默认 admin，生产请务必修改）
ADMIN_PASSWORD=admin

# JWT 签名密钥（生产请设置为足够长的随机串，例如： openssl rand -hex 32）
JWT_SECRET=please-change-me-to-a-long-random-secret

# 登录签发 Token 有效期（天），默认 7
TOKEN_TTL_DAYS=7

# ---- 展示（可选）----
SITE_NAME=EdgeOne 监控大屏
# SITE_ICON=  站点图标 URL（留空则使用内置图标）

# ---- 腾讯云 EdgeOne 数据源（可选）----
# 空凭据时将自动进入 演示数据(DEMO) 模式；填写后为真实数据模式。
# 密钥仅需 EdgeOne 只读权限：QcloudTEOReadOnlyaccess
SECRET_ID=
SECRET_KEY=
TEO_ENDPOINT=teo.tencentcloudapi.com
TEO_REGION=ap-guangzhou

# ---- 数据源模式 ----
# auto: 有 SECRET_ID/SECRET_KEY 走真实数据，否则走演示数据
# real: 强制真实数据（缺凭据会报错）
# mock: 强制演示数据
DATA_MODE=auto

# ---- 本地服务端口 ----
PORT=8088
