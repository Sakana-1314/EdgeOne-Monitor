# =============================================================
# EdgeOne 监控大屏 - 环境变量示例
# 复制为 .env 后按需修改：  cp .env.example .env
#
# 部署到腾讯云 EdgeOne Pages 时，在「项目设置 - 环境变量」中
# 配置下列变量（无需提交密钥到仓库，.env 已被 git 忽略）。
# =============================================================

# ---- 鉴权（必填）----
# 登录账号固定为 admin，此处配置密码（本地开发可先设为任意值）
ADMIN_PASSWORD=change-me

# JWT 签名密钥（生产请设置为足够长的随机串，例如： openssl rand -hex 32）
JWT_SECRET=please-change-me-to-a-long-random-secret

# 登录签发 Token 有效期（天），默认 7
TOKEN_TTL_DAYS=7

# ---- 展示（可选）----
SITE_NAME=EdgeOne 监控大屏
# SITE_ICON=  站点图标 URL（留空则使用前端内置图标）

# ---- 腾讯云 EdgeOne 数据源（必填，否则数据接口返回 503）----
# 密钥仅需 EdgeOne 只读权限：QcloudTEOReadOnlyaccess
# 中国大陆站创建：https://console.cloud.tencent.com/cam/capi
# 国际站创建：    https://console.tencentcloud.com/cam/capi
SECRET_ID=
SECRET_KEY=

# 可选：接口地址与地域（一般无需修改）
TEO_ENDPOINT=teo.tencentcloudapi.com
TEO_REGION=ap-guangzhou

# ---- 访问限制（可选，空 = 不限制）----
# 仅允许监控的站点 ID（ZoneId，逗号分隔，如 zone-xxxx,zone-yyyy）；
# 未授权站点请求返回 403；站点受限/仅一个站点时前端自动隐藏「站点」下拉
ALLOWED_ZONE_IDS=

# ---- 本地服务端口 ----
PORT=8088
